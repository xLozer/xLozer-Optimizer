<Window x:Class="xLozerOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xLozer Optimizer" Height="780" Width="1280"
        Background="#0B0E14" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True">

    <Window.Resources>
        <!-- Estilo de Botão do Menu Lateral -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161B22"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo de Botão de Ação Moderno -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Moderno de ToggleSwitch -->
        <Style x:Key="ModernToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="SwitchTrack" Background="#21262D" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1"/>
                            <Ellipse x:Name="SwitchThumb" Width="18" Height="18" Fill="#8B949E" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#1F6FEB"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#388BFD"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="White"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1F242D" BorderThickness="1" CornerRadius="10" Background="#0B0E14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA DE TÍTULO SUPERIOR (Arrastável) -->
            <Border Grid.Row="0" Background="#090C10" BorderBrush="#161B22" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦" Foreground="#388BFD" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="xLozer Optimizer" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock Text="PUBLIC PRO" Foreground="#8B949E" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="BadgeAdmin" Background="#122D1F" BorderBrush="#238636" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock x:Name="TxtAdminStatus" Text="🛡️ Admin Ativo" Foreground="#3FB950" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Click="BtnMinimize_Click" Width="32" Height="28" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                        <Button Content="✕" Click="BtnClose_Click" Width="32" Height="28" Background="Transparent" Foreground="#F85149" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CORPO PRINCIPAL -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR ESQUERDA -->
                <Border Grid.Column="0" Background="#090C10" BorderBrush="#161B22" BorderThickness="0,0,1,0" Padding="14,20">
                    <Grid>
                        <StackPanel>
                            <Button x:Name="NavDashboard" Content="🏠   Dashboard" Style="{StaticResource SidebarButtonStyle}" Background="#161B22" Foreground="#58A6FF" Click="NavDashboard_Click"/>
                            <Button x:Name="NavBooster" Content="⚡   Live Booster &amp; Apps" Style="{StaticResource SidebarButtonStyle}" Click="NavBooster_Click"/>
                            <Button x:Name="NavWhitelist" Content="🛡️   Ignorados (Whitelist)" Style="{StaticResource SidebarButtonStyle}" Click="NavWhitelist_Click"/>
                            <Separator Background="#161B22" Margin="0,8,0,12"/>
                            <Button x:Name="NavCleaner" Content="🧹   Limpar Cache RAM" Style="{StaticResource SidebarButtonStyle}" Click="BtnClearRam_Click"/>
                            <Button x:Name="NavRestore" Content="🔄   Restaurar Serviços" Style="{StaticResource SidebarButtonStyle}" Click="BtnRestore_Click"/>
                        </StackPanel>

                        <!-- Rodapé da Sidebar -->
                        <StackPanel VerticalAlignment="Bottom" Margin="6,0,6,4">
                            <Border Background="#12161F" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Auto-RAM Cleaner" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ChkAutoClean" IsChecked="True" Style="{StaticResource ModernToggleStyle}" HorizontalAlignment="Right" Checked="ChkAutoClean_Changed" Unchecked="ChkAutoClean_Changed"/>
                                    </DockPanel>
                                    <TextBlock Text="Limpa cache se uso > 85%" Foreground="#8B949E" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="xLozer Code • v2.1" Foreground="#484F58" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTEÚDO DINÂMICO DIREITO -->
                <Grid Grid.Column="1" Margin="32,24,32,24">

                    <!-- ==================== VISÃO 1: DASHBOARD (6 CARTÕES SPARKLE) ==================== -->
                    <ScrollViewer x:Name="ViewDashboard" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <TextBlock Text="What's up, " Foreground="White" FontSize="26" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtUserName" Text="xLozer" Foreground="#2F9E8F" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>

                            <UniformGrid Columns="3" HorizontalAlignment="Stretch">

                                <!-- CARTÃO 1: CPU -->
                                <Border Background="#11151C" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,16,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="42" Height="42" Background="#122338" CornerRadius="10">
                                                <TextBlock Text="🔲" Foreground="#388BFD" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="CPU" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="Processor Information" Foreground="#8B949E" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Model" Foreground="#8B949E" FontSize="11"/>
                                        <TextBlock x:Name="TxtCpuModel" Text="Detectando..." Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,10"/>
                                        <TextBlock Text="Cores &amp; Real-Time Load" Foreground="#8B949E" FontSize="11"/>
                                        <DockPanel Margin="0,2,0,6">
                                            <TextBlock x:Name="TxtCpuCores" Text="6 Cores" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtCpuLivePercent" Text="0.0%" Foreground="#388BFD" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="BarCpu" Height="6" Minimum="0" Maximum="100" Value="15" Background="#1F242D" Foreground="#388BFD" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARTÃO 2: GPU -->
                                <Border Background="#11151C" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,16,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="42" Height="42" Background="#0F2922" CornerRadius="10">
                                                <TextBlock Text="🎮" Foreground="#2EA043" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="GPU" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="Graphics Information" Foreground="#8B949E" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Model" Foreground="#8B949E" FontSize="11"/>
                                        <TextBlock x:Name="TxtGpuModel" Text="Detectando..." Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,10"/>
                                        <TextBlock Text="Type" Foreground="#8B949E" FontSize="11"/>
                                        <TextBlock x:Name="TxtGpuType" Text="Integrated" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARTÃO 3: MEMORY -->
                                <Border Background="#11151C" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="42" Height="42" Background="#241834" CornerRadius="10">
                                                <TextBlock Text="📏" Foreground="#A371F7" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Memory" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="RAM Information" Foreground="#8B949E" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Total Memory &amp; Type" Foreground="#8B949E" FontSize="11"/>
                                        <DockPanel Margin="0,2,0,10">
                                            <TextBlock x:Name="TxtRamTotal" Text="16.0 GB" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtRamType" Text="DDR4" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="Real-Time Consumption" Foreground="#8B949E" FontSize="11"/>
                                        <DockPanel Margin="0,2,0,6">
                                            <TextBlock x:Name="TxtRamAvailable" Text="Livres: 4.5 GB" Foreground="#3FB950" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtRamLivePercent" Text="60%" Foreground="#A371F7" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ProgressBar x:Name="BarRam" Height="6" Minimum="0" Maximum="100" Value="60" Background="#1F242D" Foreground="#A371F7" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARTÃO 4: SYSTEM -->
                                <Border Background="#11151C" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,16,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="42" Height="42" Background="#2D161B" CornerRadius="10">
                                                <TextBlock Text="💻" Foreground="#F85149" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="System" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="OS Information" Foreground="#8B949E" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Operating System" Foreground="#8B949E" FontSize="11"/>
                                        <TextBlock x:Name="TxtOsName" Text="Windows 11 Pro" Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,10"/>
                                        <TextBlock Text="Version" Foreground="#8B949E" FontSize="11"/>
                                        <TextBlock x:Name="TxtOsVersion" Text="Build 26100" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARTÃO 5: STORAGE -->
                                <Border Background="#11151C" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,16,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="42" Height="42" Background="#2B2111" CornerRadius="10">
                                                <TextBlock Text="💽" Foreground="#D29922" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Storage" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="Disk Information" Foreground="#8B949E" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Primary Disk" Foreground="#8B949E" FontSize="11"/>
                                        <TextBlock x:Name="TxtDiskModel" Text="NVMe SSD" Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,10"/>
                                        <TextBlock Text="Capacity &amp; Free Space" Foreground="#8B949E" FontSize="11"/>
                                        <TextBlock x:Name="TxtDiskSpace" Text="953 GB" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARTÃO 6: TWEAKS & BOOSTER -->
                                <Border Background="#11151C" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="42" Height="42" Background="#0F2922" CornerRadius="10">
                                                <TextBlock Text="🔧" Foreground="#3FB950" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Live Booster" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="Background Scanner" Foreground="#8B949E" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Detected Background Targets" Foreground="#8B949E" FontSize="11"/>
                                        <TextBlock x:Name="TxtTotalDetected" Text="0 Processos / Serviços" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,2,0,10"/>
                                        <TextBlock Text="Selected for Optimization" Foreground="#8B949E" FontSize="11"/>
                                        <TextBlock x:Name="TxtSelectedCount" Text="0 Marcados para Pausar" Foreground="#3FB950" FontSize="13" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>

                            <!-- BANNER INFERIOR DE AÇÃO RÁPIDA -->
                            <Border Background="#11151C" BorderBrush="#1F6FEB" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,8,0,0">
                                <DockPanel>
                                    <Border Width="40" Height="40" Background="#0F2922" CornerRadius="8" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" Foreground="#3FB950" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Vai iniciar uma Live ou Jogar agora?" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtStatusBanner" Text="Subprocessos do FiveM e OBS estão protegidos. Suas escolhas ficam salvas automaticamente." Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="🧹 Limpar RAM Agora" Style="{StaticResource ActionButtonStyle}" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Margin="0,0,10,0" Click="BtnClearRam_Click"/>
                                        <Button Content="⚡ Abrir Live Booster" Style="{StaticResource ActionButtonStyle}" Background="#1F6FEB" BorderBrush="#388BFD" BorderThickness="1" Click="NavBooster_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== VISÃO 2: LIVE BOOSTER (LISTA DE PROCESSOS E SERVIÇOS) ==================== -->
                    <Grid x:Name="ViewBooster" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho da Lista -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Otimização Inteligente em Segundo Plano" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Suas marcações são salvas automaticamente. Clique em '🛡️ Ignorar' para enviar um app para a Whitelist permanente." Foreground="#8B949E" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="🔄 Re-escanear Sistema" Style="{StaticResource ActionButtonStyle}" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnRescan_Click"/>
                        </DockPanel>

                        <!-- Lista Detalhada de Processos e Serviços -->
                        <Border Grid.Row="1" Background="#11151C" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="12" Padding="12">
                            <ListView ItemsSource="{Binding ProcessList}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Toggle Switch Moderno (Salva preferência ao clicar) -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding ShouldOptimize, Mode=TwoWay}" Style="{StaticResource ModernToggleStyle}" VerticalAlignment="Center"/>

                                            <!-- Nome e Descrição -->
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Botão Ignorar Sempre (Envia para a Whitelist) -->
                                            <Button Grid.Column="2" Content="🛡️ Ignorar" Tag="{Binding Name}" Click="BtnIgnoreItem_Click"
                                                    ToolTip="Adicionar à Whitelist para nunca mais listar ou encerrar este processo"
                                                    Background="#12161F" Foreground="#8B949E" BorderBrush="#30363D" BorderThickness="1"
                                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="8,0" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Badge de Categoria (Processo vs Serviço) -->
                                            <Border Grid.Column="3" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="4,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" Foreground="#8B949E" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Consumo de Memória RAM -->
                                            <Border Grid.Column="4" Width="85" Background="#122338" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MemoryUsageText}" Foreground="#58A6FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <!-- Barra de Botões Inferior -->
                        <DockPanel Grid.Row="2" Margin="0,16,0,0">
                            <TextBlock x:Name="TxtBoosterFooter" Text="Pronto para otimizar." Foreground="#8B949E" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🧹 Limpar Cache RAM" Click="BtnClearRam_Click" Style="{StaticResource ActionButtonStyle}" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Margin="0,0,10,0"/>
                                <Button Content="🔄 Restaurar Serviços (Pós-Live)" Click="BtnRestore_Click" Style="{StaticResource ActionButtonStyle}" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Margin="0,0,10,0"/>
                                <Button x:Name="BtnOptimize" Content="⚡ Aplicar Otimização (Live Mode)" Click="BtnOptimize_Click" Style="{StaticResource ActionButtonStyle}" Background="#238636" BorderBrush="#2EA043" BorderThickness="1"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <!-- ==================== VISÃO 3: IGNORADOS / WHITELIST PERMANENTE ==================== -->
                    <Grid x:Name="ViewWhitelist" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="Processos Protegidos (Whitelist)" Foreground="White" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Programas listados abaixo estão 100% blindados (além do FiveM, OBS e processos nativos do Windows). Eles nunca serão encerrados." Foreground="#8B949E" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Barra para adicionar processo manualmente pelo nome -->
                        <Border Grid.Row="1" Background="#11151C" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCustomIgnore" Grid.Column="0" Background="#0B0E14" Foreground="White" BorderBrush="#30363D" BorderThickness="1" Padding="12,8" FontSize="13" VerticalContentAlignment="Center"
                                         Tag="Digite o nome do processo (ex: Twinkle Tray, Overwolf, Voicemeeter)..."/>
                                <Button Grid.Column="1" Content="➕ Adicionar à Whitelist" Click="BtnAddCustomIgnore_Click" Style="{StaticResource ActionButtonStyle}" Background="#1F6FEB" BorderBrush="#388BFD" BorderThickness="1" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Lista de Processos Ignorados Salvos -->
                        <Border Grid.Row="2" Background="#11151C" BorderBrush="#1F242D" BorderThickness="1" CornerRadius="12" Padding="12">
                            <ListView ItemsSource="{Binding IgnoredList}" Background="Transparent" BorderThickness="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🛡️" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding}" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Text=" (Protegido permanentemente)" Foreground="#3FB950" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <Button Content="🗑️ Remover da Whitelist" Tag="{Binding}" Click="BtnRemoveIgnore_Click"
                                                    HorizontalAlignment="Right" Style="{StaticResource ActionButtonStyle}"
                                                    Background="#2D161B" BorderBrush="#F85149" BorderThickness="1"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>